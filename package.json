{
  "name": "fragmenta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/lint.cjs",
    "prebuild": "npm run typecheck && npm run lint && npm run design:verify && npm run tools:verify && npm run motion:verify && npm run catalog:export && npm run composition:verify && npm run catalog:verify && npm run catalog:graph && npm run catalog:regression && npm run catalog:exports && npm run catalog:focus && npm run catalog:smoke",
    "build": "vite build",
    "preview": "vite preview",
    "design:verify": "node scripts/check-design-styles.cjs",
    "tools:verify": "node scripts/check-tools.cjs",
    "predev": "npm run catalog:export",
    "catalog:verify": "node scripts/check-content-ideas.cjs",
    "catalog:export": "node scripts/check-knowledge-graph.cjs && node scripts/export-knowledge.cjs",
    "catalog:smoke": "node scripts/check-knowledge-ui.cjs",
    "catalog:regression": "node scripts/test-knowledge-guards.cjs && node scripts/test-knowledge-graph.cjs",
    "catalog:graph": "node scripts/check-knowledge-graph.cjs",
    "catalog:exports": "node scripts/check-knowledge-exports.cjs && node scripts/test-knowledge-exports.cjs",
    "catalog:focus": "node scripts/test-knowledge-focus.cjs",
    "composition:verify": "node scripts/check-composition-guides.cjs && node scripts/check-composition-discovery.cjs && node scripts/test-composition-regressions.cjs",
    "motion:verify": "node scripts/check-site-motion.cjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "~7.0.2",
    "typescript-legacy": "npm:typescript@~5.8.2",
    "vite": "8.3.8"
  }
}
